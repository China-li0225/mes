<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[pg虚拟机]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT a.*,a.equivalentyield/b.equivalentyield equivalentyield1 FROM 
	(SELECT * FROM  demo.wind_field_information_view WHERE time = '2024-07') a 
	LEFT JOIN (SELECT * FROM  demo.wind_field_information_view WHERE time = '2023-07') b 
		ON a.asset_id = b.asset_id and split_part(a.time ,'-', 2) =  split_part(b.time ,'-', 2)]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
